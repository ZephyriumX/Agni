# ---- Backend configuration (export in your shell / PowerShell; NEVER commit real values) ----
AGNI_ENV=development                 # development | production
AGNI_AUTH_MODE=token                 # token (per-user bearer tokens) | supabase (verify Supabase Auth JWTs)

# Supabase: Project Settings -> Database -> Connection string (URI). Use the *pooler* string on IPv4-only
# networks. Keep sslmode=require. SERVER-ONLY secret; it never goes into the Flutter app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Only for AGNI_AUTH_MODE=supabase (Project Settings -> API -> JWT secret) or set SUPABASE_URL for JWKS
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# Optional: require header X-Registration-Key to create users. Recommended when the API is public.
AGNI_REGISTRATION_KEY=
# Optional comma-separated browser origins (leave empty for a mobile-only API)
AGNI_CORS_ORIGINS=

# For throw-away local tests ONLY (data lost on restart; refused when AGNI_ENV=production):
# AGNI_STORAGE=memory

# --- Capture timing / FPS policy (all optional; defaults shown) ---------------------------------
# Initial ENGINEERING parameters, not clinically validated limits. See docs/CAPTURE_VALIDATION.md.
# AGNI_CAPTURE_TARGET_FPS=60
# AGNI_CAPTURE_PREFERRED_MIN_FPS=58
# AGNI_CAPTURE_HARD_MIN_FPS=55
# AGNI_CAPTURE_FPS_TOLERANCE=0.25
# AGNI_CAPTURE_PASS_MAX_DROP_RATIO=0.03
# AGNI_CAPTURE_HARD_MAX_DROP_RATIO=0.05
# AGNI_CAPTURE_PASS_MAX_GAP_S=0.10
# AGNI_CAPTURE_HARD_MAX_GAP_S=0.15
# AGNI_CAPTURE_PASS_MAX_JITTER_CV=0.10
# AGNI_CAPTURE_HARD_MAX_JITTER_CV=0.20
# AGNI_CAPTURE_WINDOW_S=2.0
# AGNI_CAPTURE_PASS_MAX_LOW_WINDOW_FRACTION=0.02
# AGNI_CAPTURE_HARD_MAX_LOW_WINDOW_FRACTION=0.10
# AGNI_CAPTURE_MIN_DURATION_S=15
# AGNI_CAPTURE_RECOMMENDED_DURATION_S=30
